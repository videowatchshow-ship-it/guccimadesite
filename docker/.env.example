# ─── 구찌야놀자 플랫폼 환경변수 예시 ────────────────────────────────────────
# 복사 후 .env로 저장하고 실제 값으로 교체하세요
# cp .env.example .env

# ─── 도메인 ──────────────────────────────────────────────────────────────────
DOMAIN=xn--2e0bj1fruw33b6ti.net
NEXT_PUBLIC_DOMAIN=xn--2e0bj1fruw33b6ti.net
NEXT_PUBLIC_API_URL=https://xn--2e0bj1fruw33b6ti.net/api
NEXT_PUBLIC_WS_URL=wss://xn--2e0bj1fruw33b6ti.net

# ─── 데이터베이스 ────────────────────────────────────────────────────────────
DB_ROOT_PASS=CHANGE_ME_ROOT_PASS
DB_NAME=guccimadesite
DB_USER=gucci
DB_PASS=CHANGE_ME_DB_PASS

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASS=CHANGE_ME_REDIS_PASS

# ─── JWT / 세션 ──────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Official: https://developers.google.com/identity/protocols/oauth2
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

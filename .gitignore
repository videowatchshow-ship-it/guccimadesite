# 구찌야놀자.net .gitignore (정규식 완전체)
# 생성일: 2026-06-02

# ===== 환경 변수 =====
^\.env$
^\.env\.local$
^\.env\.production$
^\.env\.development$

# ===== 의존성 =====
^vendor\/
^node_modules\/
^bower_components\/

# ===== 로그 파일 =====
.*\.log$
^logs\/
^npm-debug\.log$
^yarn-error\.log$

# ===== 업로드 파일 =====
^uploads\/
^storage\/
^public\/uploads\/

# ===== 캐시 =====
^cache\/
^tmp\/
^temp\/
^\.cache\/

# ===== 세션 =====
^sessions\/
^\.sessions\/

# ===== 백업 =====
^backup\/
^backups\/
.*\.backup$
.*\.bak$

# ===== 컴파일 된 파일 =====
.*\.pyc$
.*\.pyo$
.*\.class$
.*\.o$

# ===== IDE 설정 =====
^\.vscode\/
^\.idea\/
^\.DS_Store$
^Thumbs\.db$

# ===== 빌드 출력 =====
^dist\/
^build\/
^out\/

# ===== 테스트 커버리지 =====
^coverage\/
^\.nyc_output\/

# ===== 패키지 파일 =====
.*\.tar\.gz$
.*\.zip$
.*\.rar$

# ===== OS 생성 파일 =====
^\.DS_Store$
^Thumbs\.db$
^desktop\.ini$

# ===== PHP 특정 =====
^composer\.phar$
^php_errors\.log$

# ===== Node.js 특정 =====
^package-lock\.json$ # 프로젝트에 따라 포함 여부 선택
^yarn\.lock$ # 프로젝트에 따라 포함 여부 선택

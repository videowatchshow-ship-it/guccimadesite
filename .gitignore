# .gitignore - 구찌야놀자.net 프로젝트
# 표준: POSIX 정규표현식 (전세계 표준)
# 생성일: 2026-06-03
# 
# 이 파일의 목적:
#   로컬: 모든 파일 포함 (개발/테스트/백업용)
#   깃: 소스코드만 포함 (배포 버전)
#   서버: 깃에서 pull한 파일만 실행

# ================================
# 로컬 개발 전용 (서버 배포 불필요)
# ================================

# Python 분석/테스트 스크립트
*.py
!setup.py

# 백업 및 임시 파일
/backups/
/backup/
*.backup
*.bak
*.tmp

# Kiro IDE 설정 (로컬 개발 도구)
/.kiro/

# Docker 개발 설정 (로컬 전용)
/docker/
docker-compose.*.yml

# 유틸리티 스크립트
/scripts/
*.sh
!deploy.sh

# 문서 (로컬 참고용)
/docs/
README.md
*.md
!DEPLOYMENT.md

# ================================
# 환경 설정 (모든 환경)
# ================================

# 환경 변수 - 절대 커밋 금지
.env
.env.local
.env.*.local
.env.production
.env.development
.env.testing

# ================================
# 런타임 생성 파일 (서버용)
# ================================

# 로그 파일
*.log
logs/
npm-debug.log
yarn-error.log
php_errors.log

# 캐시 디렉토리
cache/
tmp/
temp/
.cache/
/storage/

# 세션 데이터
sessions/
.sessions/

# 업로드 임시 파일
uploads/
public/uploads/

# ================================
# 의존성 및 패키지
# ================================

# PHP 의존성
vendor/
composer.phar

# Node.js 의존성
node_modules/
npm-debug.log*
yarn-error.log*

# Bower
bower_components/

# ================================
# 빌드 및 컴파일 출력
# ================================

# Python 컴파일 파일
__pycache__/
*.py[cod]
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

# Java/C++ 컴파일
*.class
*.o
*.a
*.so

# IDE 및 에디터
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.project
.settings/

# 테스트 커버리지
coverage/
.nyc_output/
htmlcov/

# ================================
# OS 및 시스템 파일
# ================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp

# ================================
# 압축 파일 (로컬 백업)
# ================================

*.tar
*.tar.gz
*.tar.bz2
*.zip
*.rar
*.7z

# ================================
# 허용 예외 (강제 포함)
# ================================

# 다음 파일들은 반드시 포함
!.gitkeep
!.env.example
!.htaccess

# ================================
# 정책
# ================================

# ⚠️  WARNING: .env 파일은 절대 커밋하지 마세요!
# 만약 실수로 커밋했다면:
# git rm --cached .env
# git commit --amend --no-edit
# git push --force-with-lease

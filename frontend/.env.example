# Frontend 환경 변수 설정 (2026-06-01)
# 공식 문서: https://nextjs.org/docs/basic-features/environment-variables

# ─── API 설정 ────────────────────────────────────────────────────────────────
# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ─── 도메인 설정 ─────────────────────────────────────────────────────────────
# 도메인명
NEXT_PUBLIC_DOMAIN=xn--2e0bj1fruw33b6ti.net

# ─── Google OAuth 설정 ───────────────────────────────────────────────────────
# Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── 분석 설정 ───────────────────────────────────────────────────────────────
# Google Analytics ID
NEXT_PUBLIC_GA_ID=your_ga_id_here

# ─── 환경 설정 ───────────────────────────────────────────────────────────────
# 환경 (development, production)
NODE_ENV=production

# ─── 빌드 설정 ───────────────────────────────────────────────────────────────
# 빌드 타겟
NEXT_PUBLIC_BUILD_TARGET=standalone

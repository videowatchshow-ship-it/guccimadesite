# Apache 공식 문서 기반 .htaccess
# ref: https://httpd.apache.org/docs/2.4/howto/htaccess.html

# ── HTTPS 강제 리다이렉트 (조건부)
# ref: https://httpd.apache.org/docs/2.4/rewrite/remapping.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # SSL 인증서가 유효한 경우에만 HTTPS 리다이렉트
    # 자체 서명 인증서 사용 중에는 리다이렉트 비활성화
    # Let's Encrypt 발급 후 아래 주석 해제
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ── 보안 헤더
# ref: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers
<IfModule mod_headers.c>
    # XSS 방어
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    
    # HTTPS 전용 (Let's Encrypt 발급 후 활성화)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    
    # 레퍼러 정책
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # 권한 정책
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── 캐시 제어 (header.html은 항상 최신)
# ref: https://httpd.apache.org/docs/2.4/mod/mod_headers.html
<IfModule mod_headers.c>
    <FilesMatch "^(header\.html|_header_fetch.*\.js|mobile-chat\.html)$">
        Header unset Cache-Control
        Header unset Pragma
        Header unset Expires
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

# ── 민감 파일 접근 차단
# ref: https://httpd.apache.org/docs/2.4/mod/core.html#files
<FilesMatch "(\.env|\.git|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# ── DirectoryIndex 우선순위
# ref: https://httpd.apache.org/docs/2.4/mod/mod_dir.html#directoryindex
DirectoryIndex index.php index.html

# ── PHP 파일 보호 (추가 보안)
<FilesMatch "^(config|db-helper|security-headers|seo-meta|mobile-helper)\.php$">
    Require all denied
</FilesMatch>
